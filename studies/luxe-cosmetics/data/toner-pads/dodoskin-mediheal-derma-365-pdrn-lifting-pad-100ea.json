ter--\u003e\n\u003ch4\u003eSpecs\u003c\/h4\u003e\n\u003cp\u003eBrand : MEDIHEAL \u003cbr\u003eCapacity : 100ea\u003cbr\u003eTarget Area : Face\u003cbr\u003eSkin Type : All Skin Types\u003cbr\u003eCountry of origin : South Korea\u003c\/p\u003e\n\u003c\/div\u003e\n\u003c!--kdrop--\u003e\u003c!--↑↑↑↑↑↑Please insert contents↑↑↑↑↑↑↑↑--\u003e\n\u003cp\u003e \u003c\/p\u003e","vendor":"MEDIHEAL","product_type":"Sheet Mask","created_at":"2026-05-06T22:50:19-07:00","handle":"mediheal-derma-365-pdrn-lifting-pad-100ea","updated_at":"2026-10-30T21:28:47-07:00","published_at":"2026-05-06T22:55:22-07:00","template_suffix":"","published_scope":"global","tags":"new, Niacinamide","variants":[{"id":46819886071964,"product_id":9011975717020,"title":"Default Title","price":"27.42","sku":"8809936745106","position":1,"compare_at_price":"36.90","fulfillment_service":"manual","inventory_management":"shopify","option1":"Default Title","option2":null,"option3":null,"created_at":"2026-05-06T22:50:20-07:00","updated_at":"2026-10-30T21:28:47-07:00","taxable":true,"barcode":"8809936745106","grams":0,"image_id":null,"weight":0.0,"weight_unit":"g","requires_shipping":true,"quantity_rule":{"min":1,"max":null,"increment":1},"price_currency":"USD","compare_at_price_currency":"USD","quantity_price_breaks":[]}],"options":[{"id":11350243737756,"product_id":9011975717020,"name":"Title","position":1,"values":["Default Title"]}],"images":[{"id":44793034703004,"product_id":9011975717020,"position":1,"created_at":"2026-05-06T22:53:38-07:00","updated_at":"2026-05-06T22:53:40-07:00","alt":null,"width":1000,"height":1000,"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0506\/2121\/8972\/files\/A00000017142679ko.webp?v=1778133220","variant_ids":[]},{"id":44793035456668,"product_id":9011975717020,"position":2,"created_at":"2026-05-06T22:54:27-07:00","updated_at":"2026-05-06T22:54:28-07:00","alt":null,"width":1000,"height":1000,"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0506\/2121\/8972\/files\/20251224_110813__-